from pathlib import Path

import pandas as pd


DATASET = Path(
    'data/raw/nevworld_614258720572051651_20261005_182715.jsonl'
)

if not DATASET.exists():
    raise FileNotFoundError(
        'No se encuentra: {DATASET.resolve()}'
    )

df = pd.read_json(DATASET, lines=True)
required = [
    'run_id', 'event_index', 'tick', 'type'
]

assert not df.empty, 'El dataset está vacío'
assert all(column in df.columns for column in required), \
    'Faltan columnas principales'
assert not df.duplicated(['run_id', 'event_index']).any(), \
    'Hay eventos duplicados'

ordered = df.sort_values('event_index')
assert ordered['tick'].is_monotonic_increasing, \
    'Los ticks retroceden'

validacion = 'OK'

filas, columnas = df.shape
print('\nNombre del archivo JSONL: ', df['run_id'].iloc[0])
print('Numero total de eventos: ', filas)
print('Numero de columnas: ', columnas)
print('Nombre de las columnas: ', df.columns.tolist())
print('Tipo del primer evento registrado: ', df['type'].iloc[0])
print('Tipo de evento más frecuente y cantidad: ', df['type'].value_counts().index[0] , df['type'].value_counts().iloc[0])
print('Todos los tipos de evento: ', df['type'].value_counts())
print('Run_id, semilla y versión del esquema de la primera fila: ', df['run_id'].iloc[0], df['seed'].iloc[0], df['schema_version'].iloc[0])
print('Tick minimo y tick maximo: ', df['tick'].min(), df['tick'].max())
print('Resultado de las validaciones: ', validacion)
print (df['type'].value_counts())





